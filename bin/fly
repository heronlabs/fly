#!/bin/sh
# fly CLI: runs cli.js on fly's own Electron (the checkout's, or the installed
# bundle's) in Node mode, the way VSCode's `code` does, so no separate Node is needed.
set -eu

# Follow the symlink chain (e.g. ~/.local/bin/fly, /usr/local/bin/fly, or /usr/bin/fly
# through /etc/alternatives) back to the checkout or the installed app's resources/bin/fly.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd -P)

# Three layouts share this script. Installed, ROOT holds app.asar: on macOS ROOT is
# fly.app/Contents/Resources and Electron is Contents/MacOS/fly; in the Linux
# package ROOT is /opt/fly/resources and Electron is /opt/fly/fly. Checkout: ROOT is
# the repo.
if [ -f "$ROOT/app.asar" ]; then
  if [ -d "$ROOT/../MacOS" ]; then
    EXE_DIR="$ROOT/../MacOS"
  else
    EXE_DIR="$ROOT/.."
  fi
  ELECTRON="$EXE_DIR/fly"
  CLI="$ROOT/app.asar/out/main/cli.js"
  if [ ! -x "$ELECTRON" ]; then
    echo "fly: executável não encontrado em $(cd "$EXE_DIR" 2>/dev/null && pwd -P || echo "$EXE_DIR"): reinstale o fly" >&2
    exit 1
  fi
else
  ELECTRON=""
  CLI="$ROOT/out/main/cli.js"
  if [ -f "$ROOT/node_modules/electron/path.txt" ]; then
    ELECTRON="$ROOT/node_modules/electron/dist/$(cat "$ROOT/node_modules/electron/path.txt")"
  fi
  if [ ! -x "$ELECTRON" ]; then
    echo "fly: Electron não encontrado em $ROOT/node_modules: rode pnpm install em $ROOT" >&2
    exit 1
  fi
  if [ ! -f "$CLI" ]; then
    echo "fly: build não encontrado em $ROOT/out: rode pnpm build em $ROOT" >&2
    exit 1
  fi
fi

ELECTRON_RUN_AS_NODE=1 exec "$ELECTRON" "$CLI" "$@"
