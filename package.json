{
  "author": "Heron Labs",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/museomoderno": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.15"
  },
  "description": "fly — heronlabs agent cockpit",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-yml": "^3.9.0",
    "gts": "^7.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "name": "@heronlabs/fly",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "@swc/core",
      "@nestjs/core",
      "node-pty"
    ]
  },
  "prettier": "gts/.prettierrc.json",
  "private": true,
  "productName": "fly",
  "scripts": {
    "build": "electron-vite build",
    "dep:cruise": "depcruise src --config .dependency-cruiser.json",
    "dev": "electron-vite dev",
    "dist": "electron-builder",
    "lint:check": "gts lint && eslint \"**/*.json\" \"**/*.yml\" \"**/*.yaml\" --no-error-on-unmatched-pattern --ignore-pattern '.serena/**'",
    "lint:fix": "gts fix && eslint \"**/*.json\" \"**/*.yml\" \"**/*.yaml\" --fix --no-error-on-unmatched-pattern --ignore-pattern '.serena/**'",
    "postinstall": "node node_modules/electron/install.js && (chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true)",
    "preview": "electron-vite preview",
    "test:di": "vitest run --project di",
    "test:unit": "vitest run --coverage --project node --project ui",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "version": "0.0.2"
}
